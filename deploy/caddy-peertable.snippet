# ~/license-server/Caddyfile の「Tunnel-served kitepon.dev END」の直前へ追加する block。
# 既存サブドメイン（relay 等）と同型: Origin Cert TLS + LAN ポートへの透過 proxy。
# flush_interval -1 は SSE（ライブビュー）のため必須。

peertable.kitepon.dev {
	import cf-origin-tls
	import security-headers-base
	reverse_proxy 192.168.1.2:18860 {
		flush_interval -1
	}
}
